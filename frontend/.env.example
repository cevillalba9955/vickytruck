# Origen del backend (solo el protocolo+host, sin path) para producción —
# ej. https://vickytruck.fly.dev. Vacío/sin setear en dev: las llamadas
# quedan relativas (/api/recorridos/...) y las resuelve el proxy de
# vite.config.js. Ver .env.production (se commitea, no es secreto).
VITE_API_BASE_URL=

# La URL/usuario/contraseña del broker MQTT YA NO se configuran acá: el
# backend las devuelve por-flete en GET /api/recorridos/:token (campo
# `recorrido.mqtt`, aprovisionado en backend/src/mqtt/emqxProvisioning.js) —
# así el bundle público nunca embebe una credencial de alcance más amplio que
# "publicar la ubicación de este flete". Ver frontend/src/services/ubicacionMqtt.js.

# Reconexión automática del cliente MQTT (ms). Este sí es un knob de
# comportamiento del cliente, no una credencial — se queda acá.
VITE_MQTT_RECONNECT_MS=3000
