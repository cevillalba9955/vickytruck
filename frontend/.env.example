# Origen del backend (solo el protocolo+host, sin path) para producción —
# ej. https://vickytruck.fly.dev. Vacío/sin setear en dev: las llamadas
# quedan relativas (/api/recorridos/...) y las resuelve el proxy de
# vite.config.js. Ver .env.production (se commitea, no es secreto).
VITE_API_BASE_URL=

# Broker MQTT sobre WebSocket seguro para publicar ubicación en vivo del chofer.
# Ejemplo: wss://mqtt.vickytruck.example.com:8084/mqtt
VITE_MQTT_BROKER_URL=

# Credenciales técnicas para publicar en el broker MQTT.
VITE_MQTT_USERNAME=
VITE_MQTT_PASSWORD=

# Reconexión automática del cliente MQTT (ms).
VITE_MQTT_RECONNECT_MS=3000
