# Endpoint backend para API de Central (opcional si se usa proxy local de Vite).
VITE_API_BASE_URL=/api/central

# Broker MQTT sobre WebSocket seguro para ubicación en tiempo real.
# Ejemplo: wss://mqtt.vickytruck.example.com:8084/mqtt
VITE_MQTT_BROKER_URL=

# Credenciales técnicas para consumo MQTT desde el panel Central.
VITE_MQTT_USERNAME=
VITE_MQTT_PASSWORD=

# Reconexión automática del cliente MQTT (ms).
VITE_MQTT_RECONNECT_MS=3000
