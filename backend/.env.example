# Configuración de conexión a Oracle para la API del chofer (feature 001-chofer-recorrido).
# Oracle es la única fuente de verdad (Constitución, Principio IV): este backend no
# mantiene copia propia de recorridos/puntos, solo lee y escribe contra estas tablas.
#
# NUNCA se commitea un .env con valores reales: estos son solo placeholders.
# Las credenciales viajan EXCLUSIVAMENTE por entorno, nunca por argv/logs.

# Usuario Oracle con permiso de lectura/escritura sobre las tablas de recorrido,
# punto de entrega y token (las mismas que precarga la futura feature de Central).
ORACLE_USER=chofer_app

# Contraseña del usuario. Nunca se loguea ni aparece en mensajes de error.
ORACLE_PASSWORD=cambiame

# Cadena de conexión EZCONNECT: host:puerto/servicio.
ORACLE_CONNECT_STRING=oracle.vickytruck.example.local:1521/VICKYTRUCK

# Tamaño del pool de conexiones (default 4). Entero > 0.
ORACLE_POOL_MAX=4

# Timeout por consulta en milisegundos (default 10000). Entero > 0.
ORACLE_QUERY_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Nombres de tablas/columnas: la feature de Central es dueña del esquema real;
# estos overrides permiten apuntar este backend al esquema efectivo sin tocar
# código. Identificadores SQL estrictos (permiten `esquema.tabla`).
#
# IMPORTANTE: si el usuario Oracle que conecta (ORACLE_USER) es distinto del
# dueño de las vistas/package (ej. el usuario es VICKYTRUCK pero los objetos
# son de VIC), hay que calificar con el esquema (ej. VIC.V_RECORRIDOS,
# VIC.RECORRIDO_API) — sin el prefijo, Oracle no resuelve el nombre
# (ORA-00942 / PLS-00201) aunque el GRANT ya esté otorgado.
# ---------------------------------------------------------------------------

# Tabla de recorridos (columnas esperadas: ID, TOKEN, ESTADO).
ORACLE_TABLA_RECORRIDOS=RECORRIDOS

# Tabla de puntos de entrega (columnas esperadas: ID, RECORRIDO_ID, ORDEN, LATITUD,
# LONGITUD, ESTADO, ARRIBO_EN, ARRIBO_LAT, ARRIBO_LON, DESCARGA_EN, DESCARGA_LAT,
# DESCARGA_LON).
ORACLE_TABLA_PUNTOS=PUNTOS_ENTREGA

# Package PL/SQL que expone marcar_arribo/marcar_descarga — única vía de
# escritura sobre los puntos de entrega, ya que las tablas de arriba son
# vistas generadas de solo lectura. Ver backend/sql/recorrido_api.pks.sql.
ORACLE_PACKAGE_RECORRIDO_API=RECORRIDO_API

# Intervalo (en milisegundos) con el que la app del chofer reporta su
# ubicación GPS instantánea mientras el recorrido está activo (FR-014). Se
# expone al frontend en la respuesta de GET /api/recorridos/:token para que
# use este mismo valor. Default 60 s. La posición reportada se guarda solo
# en memoria (nunca en Oracle) — ver ORACLE_TABLA_FLETES más abajo.
UBICACION_REPORTE_INTERVALO_MS=60000

# ---------------------------------------------------------------------------
# Central (feature 002-panel-control-central) — mismo esquema/pool de arriba.
# Nombres asumidos siguiendo la misma convención (research.md §5 de la
# feature); a confirmar/ajustar contra la instancia real, igual que ya pasó
# con ORACLE_TABLA_PUNTOS.
# ---------------------------------------------------------------------------

# Vista de solo lectura con el listado de fletes — PURAMENTE ESTÁTICA
# (columnas esperadas: ID, NOMBRE). NO tiene ni tendrá columnas de ubicación:
# la última ubicación conocida de un flete sale de memoria del backend
# (compartida con 001-chofer-recorrido), con respaldo en el último evento
# arribo/descarga ya persistido en ORACLE_TABLA_PUNTOS (research.md §8 de
# 002-panel-control-central).
ORACLE_TABLA_FLETES=V_FLETES

# Package PL/SQL que expone asignar_recorrido/reasignar_recorrido — única vía
# de escritura sobre la asignación recorrido↔flete. Ver
# backend/sql/central_api.pks.sql.
ORACLE_PACKAGE_CENTRAL_API=CENTRAL_API

# Umbral (en milisegundos) a partir del cual la última ubicación conocida de
# un flete se considera "no reciente" en el panel (FR-014). Default 5 min.
UBICACION_STALE_MS=300000

# ---------------------------------------------------------------------------
# Servidor HTTP (Express).
# ---------------------------------------------------------------------------

# Puerto donde escucha la API. Default 3001.
PORT=3001

# ---------------------------------------------------------------------------
# Bróker MQTT (feature 003-mqtt-broker-fletes) — EMQX Cloud, tier Serverless.
# Reemplaza el transporte de POST .../ubicacion, .../arribo y .../descarga:
# los fletes publican en el bróker en vez de llamar directo al backend
# (objetivo: evitar exponer IP propia, ver spec.md). Ver research.md §2 para
# el detalle de autenticación/ACL y contracts/mqtt-canal.md para el contrato
# de tópicos.
# ---------------------------------------------------------------------------

# Endpoint MQTT-sobre-TLS que usa el propio backend (conexión saliente,
# nunca entrante) para suscribirse. Formato host:puerto (default de EMQX
# Cloud: 8883).
EMQX_MQTTS_HOST=xxxxxxxx.ala.us-east-1.emqxsl.com
EMQX_MQTTS_PORT=8883

# Endpoint público MQTT-sobre-WebSocket (wss://) que se entrega a
# frontend/central para que se conecten desde el navegador. Incluye el path
# (normalmente /mqtt).
EMQX_WSS_URL=wss://xxxxxxxx.ala.us-east-1.emqxsl.com:8084/mqtt

# Credencial de servicio del backend (SUBSCRIBE en vickytruck/fletes/+/#,
# sin PUBLISH) — provisionada una vez de forma administrativa, ver
# backend/scripts/emqx-setup.js.
EMQX_BACKEND_USERNAME=vickytruck-backend
EMQX_BACKEND_PASSWORD=cambiame

# Credencial de servicio de Central (mismo alcance de solo-lectura que la de
# arriba), expuesta por el backend vía GET /api/central/mqtt-config para que
# central/ se suscriba directamente al bróker (Clarifications de spec.md).
EMQX_CENTRAL_USERNAME=vickytruck-central
EMQX_CENTRAL_PASSWORD=cambiame

# Credenciales de administración de la API de EMQX Cloud, usadas por
# backend/src/mqtt/emqxProvisioning.js para dar de alta/baja la credencial
# MQTT de cada flete (username=token) al asignar/reasignar/finalizar un
# recorrido (FR-008). Nunca se loguean ni se exponen a ningún frontend.
EMQX_CLOUD_API_KEY=cambiame
EMQX_CLOUD_API_SECRET=cambiame
EMQX_CLOUD_DEPLOYMENT_ID=cambiame
