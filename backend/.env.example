# NUNCA se commitea un .env con valores reales: estos son solo placeholders.
# Las credenciales viajan EXCLUSIVAMENTE por entorno, nunca por argv/logs.
#
# Este backend no tiene conexión directa a Oracle (spec 003, FR-001): solo
# expone endpoints. Oracle/APEX local empuja los recorridos por
# POST /api/integracion/recorridos y consulta su estado por
# GET /api/integracion/estado — ver
# specs/003-arquitectura-cloud-mqtt/contracts/integracion-api.md.

# Intervalo (en milisegundos) con el que la app del chofer reporta su
# ubicación GPS instantánea mientras el recorrido está activo (FR-014 de
# 001-chofer-recorrido). Se expone al frontend en la respuesta de
# GET /api/recorridos/:token para que use este mismo valor. Default 60 s.
UBICACION_REPORTE_INTERVALO_MS=60000

# Umbral (en milisegundos) a partir del cual la última ubicación conocida de
# un flete se considera "no reciente" en el panel de Central (FR-014 de
# 002-panel-control-central). Default 5 min.
UBICACION_STALE_MS=300000

# ---------------------------------------------------------------------------
# Servidor HTTP (Express).
# ---------------------------------------------------------------------------

# Puerto donde escucha la API. Default 3001.
PORT=3001

# Orígenes permitidos por CORS (separados por coma) — frontend/central se
# sirven desde Cloudflare Workers, otro origen que este backend en Fly.io.
# Sin esto configurado, ningún navegador puede llamar a la API desde fuera
# de este mismo origen.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---------------------------------------------------------------------------
# Integración Oracle/APEX -> Cloud (feature 003)
# ---------------------------------------------------------------------------

# Credenciales técnicas para endpoints /api/integracion/*.
# Configurar al menos una de las dos.
INTEGRACION_API_KEY=
INTEGRACION_BEARER_TOKEN=

# ---------------------------------------------------------------------------
# MQTT (feature 003) — bridge del backend: SE SUSCRIBE a chofer/+/ubicacion.
# ---------------------------------------------------------------------------

# Broker MQTT sobre TCP+TLS (mqtts://host:puerto — puerto 8883 en EMQX Cloud).
MQTT_BROKER_URL=

# Credenciales de conexión del backend bridge. Usuario de servicio dado de
# alta una sola vez (ver "npm run emqx:setup" más abajo) con ACL de solo
# SUBSCRIBE sobre MQTT_TOPIC_UBICACION — nunca PUBLISH.
MQTT_USERNAME=
MQTT_PASSWORD=

# Topic de ubicación al que se suscribe el backend.
MQTT_TOPIC_UBICACION=chofer/+/ubicacion

# Cliente y timeouts de conexión.
MQTT_BACKEND_CLIENT_ID=vickytruck-backend
MQTT_RECONNECT_MS=3000
MQTT_CONNECT_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# EMQX Cloud — aprovisionamiento de credenciales MQTT por flete
# (backend/src/mqtt/emqxProvisioning.js). Al recibir un recorrido de Oracle
# con `fleteId` (POST /api/integracion/recorridos) el backend da de alta en
# EMQX Cloud un usuario publish-only, scoped únicamente a
# chofer/{fleteId}/ubicacion, y lo devuelve en GET /api/recorridos/:token
# (campo `recorrido.mqtt`) para que el frontend lo use — así el bundle
# público del chofer nunca embebe una credencial MQTT de alcance más amplio.
# ---------------------------------------------------------------------------

# URL base de la API HTTP nativa (v5) de ESTE deployment de EMQX Cloud (la
# que muestra la consola en la sección "Connect"/"Overview" del deployment,
# puerto 8443) — NO la "Platform API" a nivel cuenta (cloud-intl.emqx.com).
EMQX_CLOUD_API_URL=

# "Deployment API Key" (App ID / App Secret) de la consola de EMQX Cloud, o
# una API Key creada dentro del propio dashboard de este deployment. Nunca se
# loguean ni se exponen a ningún frontend.
EMQX_CLOUD_API_KEY=
EMQX_CLOUD_API_SECRET=

# Identificador del mecanismo de autenticación de EMQX v5 (default: la base
# de usuarios integrada). Solo tocar si el deployment devuelve 404 en vez de
# 401/403/409 al aprovisionar.
EMQX_CLOUD_AUTH_ID=password_based:built_in_database

# Secreto propio del backend (NO es de EMQX Cloud) usado para derivar de
# forma determinística la contraseña MQTT de cada fleteId
# (HMAC-SHA256(secreto, fleteId) en emqxProvisioning.js) — NO una contraseña
# aleatoria: GET /:token puede recalcularla en cualquier momento sin volver a
# llamar a la API de EMQX, y tiene que dar siempre el mismo resultado o
# invalida la conexión ya abierta del chofer. Cambiar este valor invalida
# TODAS las credenciales de fletes ya provisionadas. Generar uno largo y
# aleatorio una sola vez, ej.: openssl rand -hex 32
EMQX_TOKEN_PASSWORD_SECRET=

# Endpoint público MQTT-sobre-WebSocket (wss://) que el backend devuelve al
# frontend en GET /:token (`recorrido.mqtt.url`) — un navegador no puede
# abrir un socket TCP crudo como el que usa MQTT_BROKER_URL de arriba.
# Incluye el path (normalmente /mqtt). Puerto default de EMQX Cloud: 8084.
EMQX_WSS_URL=

# ---------------------------------------------------------------------------
# Setup administrativo de EMQX Cloud (una sola vez por deployment,
# "npm run emqx:setup" — ver backend/scripts/emqx-setup.js): da de alta el
# usuario de servicio MQTT_USERNAME/MQTT_PASSWORD de arriba y le otorga la
# regla de ACL de solo-suscripción sobre MQTT_TOPIC_UBICACION. Reusa las
# variables EMQX_CLOUD_* de arriba, no agrega ninguna nueva.
# ---------------------------------------------------------------------------
