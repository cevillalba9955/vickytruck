{
  "name": "vickytruck-backend-chofer",
  "version": "1.0.0",
  "private": true,
  "description": "API HTTP fina (Express) para la app del chofer — resuelve token, marca arribo/descarga contra Oracle.",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --env-file-if-exists=.env --test tests/contract/*.test.js tests/integration/*.test.js",
    "smoke:oracle": "node --env-file-if-exists=.env scripts/smoke-oracle-connection.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "oracledb": "^6.5.1"
  }
}
